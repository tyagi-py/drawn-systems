      "seed": 164533449,
      "version": 93,
      "versionNonce": 1978015719,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786820046755,
      "link": null,
      "locked": false,
      "text": "Adding GPU doesn't solve DDP problems. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adding GPU doesn't solve DDP problems. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0jggArhOWR5CBCjVeDBGE",
      "type": "text",
      "x": 2337.151753918984,
      "y": 1876.1346627153848,
      "width": 980.159423828125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bXt",
      "roundness": null,
      "seed": 1760944649,
      "version": 389,
      "versionNonce": 67603207,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786820046755,
      "link": null,
      "locked": false,
      "text": "Say complete training state requires 60 GB/ GPU & you have 4 X 80 GB GPUs, this will work\nBut, if you have 100 GB/ GPU, you can't say I'll use 8 GPUs, because each GPU will need 100 GB. \n\nSo, even though 8 X 80 = 640 GB GPU memory, DDP can't take advantage of aggregate memory. \nBecause each GPU needs full replica. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Say complete training state requires 60 GB/ GPU & you have 4 X 80 GB GPUs, this will work\nBut, if you have 100 GB/ GPU, you can't say I'll use 8 GPUs, because each GPU will need 100 GB. \n\nSo, even though 8 X 80 = 640 GB GPU memory, DDP can't take advantage of aggregate memory. \nBecause each GPU needs full replica. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
