    {
      "id": "FaHbu1xsd5A3QPpmmBLa2",
      "type": "text",
      "x": 2315.9377815621897,
      "y": 1840.3787371476924,
      "width": 408.69970703125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
