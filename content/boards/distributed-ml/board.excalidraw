    {
      "id": "dAtfV38ZhD4img9xmtcaq",
      "type": "text",
      "x": 385.9861204202031,
      "y": 3602.8295826425765,
      "width": 249.29983520507812,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTX",
