    },
    {
      "id": "dAtfV38ZhD4img9xmtcaq",
      "type": "text",
      "x": 385.9861204202031,
      "y": 3602.8295826425765,
      "width": 249.29983520507812,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bTX",
      "roundness": null,
      "seed": 336320553,
      "version": 189,
      "versionNonce": 700056199,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786621687051,
      "link": null,
      "locked": false,
      "text": "You get:\n\n1. AllReduce\n2. All Gather\n3. Broadcast\n4. Reduce\n5. ReduceScatter\n6. Broadcast\n7. Point to Point Send\n8. Point to Point Receive",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You get:\n\n1. AllReduce\n2. All Gather\n3. Broadcast\n4. Reduce\n5. ReduceScatter\n6. Broadcast\n7. Point to Point Send\n8. Point to Point Receive",
      "autoResize": true,
      "lineHeight": 1.25
