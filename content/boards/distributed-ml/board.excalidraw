    },
    {
      "id": "QYbbnmKLpDZA-SVuhQMZ5",
      "type": "text",
      "x": 2333.5441613252174,
      "y": 2549.1202930947743,
      "width": 997.499267578125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bb2",
      "roundness": null,
      "seed": 373287687,
      "version": 634,
      "versionNonce": 1477659433,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786820147465,
      "link": null,
      "locked": false,
      "text": "We can do this without any problem because optimisers are calculated after gradient synchronisation. \nHence, each GPU will  have same weights, gradients, hence they come up with same optimisers. \n\nSo this is redundant calculation and memory usage.\n\nEach GPU gets responsibility to calculate the optimiser of it's shard. \nEach GPU updates a part (shard) of parameters, hence we need to sync parameters too. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can do this without any problem because optimisers are calculated after gradient synchronisation. \nHence, each GPU will  have same weights, gradients, hence they come up with same optimisers. \n\nSo this is redundant calculation and memory usage.\n\nEach GPU gets responsibility to calculate the optimiser of it's shard. \nEach GPU updates a part (shard) of parameters, hence we need to sync parameters too. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
