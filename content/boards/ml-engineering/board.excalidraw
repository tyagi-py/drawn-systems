      "isDeleted": false,
      "boundElements": [],
      "updated": 1786353460925,
      "link": null,
      "locked": false,
      "text": "\n1. loads a model\n2. keep model in memory\n3. accept inference request\n4. validate the input\n5. inference\n6. return predictions\n7. handles concurrency\n8. expose health API\n9. optimally utilise the hardware -> dynamic batching etc\n10. Handle Failure\n11. Support model versions",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n1. loads a model\n2. keep model in memory\n3. accept inference request\n4. validate the input\n5. inference\n6. return predictions\n7. handles concurrency\n8. expose health API\n9. optimally utilise the hardware -> dynamic batching etc\n10. Handle Failure\n11. Support model versions",
      "autoResize": true,
      "lineHeight": 1.25
    },
