    },
    {
      "id": "-mAbWXHLo7ylj8YUmVAnY",
      "type": "text",
      "x": 2116.4328724172856,
      "y": 873.8738601404998,
      "width": 662.49951171875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 52997228,
      "version": 433,
      "versionNonce": 241838548,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786300346613,
      "link": null,
      "locked": false,
      "text": "SLA is p99 < 100ms\ncheck for budget -> current total is say 80 ms, headroom is 20ms \n\nsay a pod takes 700 QPS/sec means it can take 0.7 per ms means, \nso in those extra 20ms you can at max handle 14 requests.\nHence having a queue bound of 10-20 makes sense.\nbackpressure, remaining, fail, trottle, will 429, or deny.\n  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SLA is p99 < 100ms\ncheck for budget -> current total is say 80 ms, headroom is 20ms \n\nsay a pod takes 700 QPS/sec means it can take 0.7 per ms means, \nso in those extra 20ms you can at max handle 14 requests.\nHence having a queue bound of 10-20 makes sense.\nbackpressure, remaining, fail, trottle, will 429, or deny.\n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "stcVMOwKUQux4AvZobFFb",
      "type": "rectangle",
      "x": 2102.978910757452,
      "y": 820.0419468998507,
      "width": 762.93359375,
      "height": 241.70703125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
