      "updated": 1786353474944,
      "link": null,
      "locked": false,
      "text": "CPU is not the only resource, \nRequest -> Gateway -> Feature Service -> Model -> Response\n\nRequest can be waiting somewhere else, for example feature DB taking 150ms now, CPU almost 0%",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CPU is not the only resource, \nRequest -> Gateway -> Feature Service -> Model -> Response\n\nRequest can be waiting somewhere else, for example feature DB taking 150ms now, CPU almost 0%",
      "autoResize": true,
      "lineHeight": 1.25
    },
