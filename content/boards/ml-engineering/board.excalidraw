      "link": null,
      "locked": false,
      "text": "queue size, timeout & backpressure",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "queue size, timeout & backpressure",
      "autoResize": true,
