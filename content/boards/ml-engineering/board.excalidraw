    {
      "id": "Uj6tygyaI-rBi9EL8N2cC",
      "type": "text",
      "x": 2106.2311754983566,
      "y": 663.4168836805554,
      "width": 754.7794189453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
