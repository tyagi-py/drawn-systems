      "versionNonce": 855349356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786298582974,
      "link": null,
      "locked": false,
      "text": "Meanwhile we're scaling or pods are busy, how many requests to put in queue?\n\nFor this, do not have just 1 replica, have min =20, max=100\nKeep enough capacity for expected spikes\nPredict the spikes and scale before",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Meanwhile we're scaling or pods are busy, how many requests to put in queue?\n\nFor this, do not have just 1 replica, have min =20, max=100\nKeep enough capacity for expected spikes\nPredict the spikes and scale before",
      "autoResize": true,
      "lineHeight": 1.25
    },
