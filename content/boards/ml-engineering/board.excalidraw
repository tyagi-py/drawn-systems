    {
      "id": "B1jlSIObQL-Ekt-bmm93X",
      "type": "text",
      "x": 2112.9513293069504,
      "y": 340.22547743055543,
      "width": 743.2394409179688,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 2053044180,
      "version": 359,
      "versionNonce": 1876726356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786298363026,
      "link": null,
      "locked": false,
      "text": "what basis we'll increase the pod?\nBased on scaling signals, like CPU utilization, memory usage, p99, QPS, etc...\nfor inference, it can be, queue wait + QPS + p99 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what basis we'll increase the pod?\nBased on scaling signals, like CPU utilization, memory usage, p99, QPS, etc...\nfor inference, it can be, queue wait + QPS + p99 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pRjrQBbJWLrwh8v2h5aJ0",
      "type": "text",
      "x": 2104.811833457341,
      "y": 295.27235243055543,
      "width": 78.59991455078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
