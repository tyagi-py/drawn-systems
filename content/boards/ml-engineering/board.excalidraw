    {
      "id": "QlV6Sh37K4QuHYIPRCctt",
      "type": "text",
      "x": 5462.487573511243,
      "y": 219.86725506472976,
      "width": 197.7798309326172,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
