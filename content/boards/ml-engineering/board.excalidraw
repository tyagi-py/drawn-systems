    {
      "id": "_tdN56U7d3Nyhk-ANdPrD",
      "type": "text",
      "x": 2052.513423337553,
      "y": 1881.6753372676285,
      "width": 1179.1192626953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2f",
      "roundness": null,
      "seed": 1818114388,
      "version": 201,
      "versionNonce": 293258580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786352615267,
      "link": null,
      "locked": false,
      "text": "Static batching we decide beforehand say 32 requests a batch, what if only 10 requests arrive? we wait for another 12.\nWhich may take seconds, hence we fail SLA for previous 10.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Static batching we decide beforehand say 32 requests a batch, what if only 10 requests arrive? we wait for another 12.\nWhich may take seconds, hence we fail SLA for previous 10.",
      "autoResize": true,
      "lineHeight": 1.25
    },
