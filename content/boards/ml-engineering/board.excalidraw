      "versionNonce": 356972500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786352806309,
      "link": null,
      "locked": false,
      "text": "Auto-scaling: Maintains Latency, Increase Cost\nDynamic Batching: Increase Latency, Better Utilization",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Auto-scaling: Maintains Latency, Increase Cost\nDynamic Batching: Increase Latency, Better Utilization",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VQ_iaCFbc6c8v_hgZnYSW",
