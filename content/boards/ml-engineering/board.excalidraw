    {
      "id": "aVntH3UVvnva_yOYWMiFK",
      "type": "text",
      "x": 3551.5582688076083,
      "y": 967.3999729576286,
      "width": 703.53955078125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
